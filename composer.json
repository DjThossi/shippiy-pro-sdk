{
    "name": "djthossi/shippy-pro-sdk",
    "description": "Typed, object-oriented PHP SDK for the ShippyPro API",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Sebastian Thoss",
            "email": "dj_thossi@web.de",
            "homepage": "http://www.sebastianthoss.de"
        }
    ],
    "require": {
        "php": ">=8.5",
        "guzzlehttp/guzzle": "^7.9",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "friendsofphp/php-cs-fixer": "^3.95",
        "giorgiosironi/eris": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "DjThossi\\ShippyProSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DjThossi\\ShippyProSdk\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
